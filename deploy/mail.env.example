# /etc/whatsapp-mcp/mail.env  (root:root, chmod 600)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password
MAIL_TO=you@gmail.com
# Optional: a free healthchecks.io check URL. Pinged every 5 minutes while
# everything is healthy; healthchecks.io e-mails you when the pings stop
# (for example, the whole VPS is down).
HEARTBEAT_URL=
